# Copy to .env (already loaded by the backend via python-dotenv).
WORKER_API_TOKEN=dev-token
# Set to 1 on any internet-facing deploy so missing WORKER_API_TOKEN fails closed.
REQUIRE_WORKER_API_TOKEN=0
# Preferred public backend URL advertised to workers.
BACKEND_PUBLIC_URL=http://YOUR_LAN_IP:8000
# Reject job submission while no worker is connected with a free slot. Set to 0
# for an HPC-primary deploy, where the dispatcher only launches Slurm workers
# after jobs are queued and no worker is warm at submission time.
WORKER_CAPACITY_REQUIRED=1
# Lease for a claimed job. Live workers renew it through progress reports and
# heartbeats, so keep it a little above the worker's Slurm walltime rather than
# very long: a job whose worker dies is only recovered after the lease expires.
LEASE_SECONDS=21600
MAX_ATTEMPTS=3
# Set 1 to reject new job/batch submissions from non-admins with HTTP 503
# (code "paused"); queued and running jobs keep going. Admins can still submit.
SUBMISSIONS_PAUSED=0
# Quotas (admins bypass all but MAX_BATCH_SIZE; over-limit submissions get HTTP 429).
# A per-user override of 0 also means unlimited for that user.
# Max jobs waiting in the queue across all users; 0 means unlimited.
MAX_QUEUED_JOBS=200
# Default max queued + running jobs per user (per-user overrides win); 0 means unlimited.
USER_MAX_ACTIVE_JOBS=20
# Default max jobs a user may submit in any rolling 24 hours; 0 means unlimited.
USER_MAX_JOBS_PER_DAY=50
# Default max genes per batch for a user (never above MAX_BATCH_SIZE); 0 means unlimited.
USER_MAX_BATCH_SIZE=25
# Absolute max genes per batch for everyone, including admins.
# MAX_BATCH_SIZE=2000
# Rate limits (HTTP 429 with code "rate_limited"); 0 means unlimited.
# Sign-up requests per client IP per rolling 24 hours.
IP_SIGNUPS_PER_DAY=5
# Sign-in code requests (/auth/login) per client IP per hour.
IP_LOGINS_PER_HOUR=30
# Job/batch submissions per client IP per hour (a batch counts once; admins exempt).
IP_SUBMITS_PER_HOUR=30
# Gene lookups per client IP per hour: /validate, /batches/validate, /jobs, and
# /batches each count once (admins exempt).
IP_VALIDATIONS_PER_HOUR=120
# Sign-in codes sent per email address per hour (signup + login).
OTP_SENDS_PER_EMAIL_PER_HOUR=5
# Set 1 only behind a proxy that overwrites X-Forwarded-For (e.g. Caddy); the
# left-most entry then becomes the client IP. Leave 0 when clients reach
# FastAPI directly, or they can spoof their IP.
TRUST_FORWARDED_FOR=0
WORKER_OFFLINE_SECONDS=60
# REQUIRED_WORKER_VERSION=
# Version string shown on /admin and /backend-info and stored in backup metadata (default "dev").
# APP_VERSION=
# Annotation history and control-plane backups (database name is fixed: gene_autoannotator).
# MONGODB_URI is an accepted alias.
# MONGO_URI=mongodb://localhost:27017/gene_autoannotator
# MONGODB_URI=
# Organism profiles are local JSON files (not MongoDB):
# PROFILES_DIR=data/profiles
# Catalog whose missing files are copied into an unseeded PROFILES_DIR (default data/profiles).
# PROFILES_SEED_DIR=
# NCBI gene-name lookups during validation; ENTREZ_API_KEY is an accepted alias.
# NCBI_API_KEY=
# ENTREZ_API_KEY=
# Admin-only regex helper: Ollama server and model (default: the consensus model).
# OLLAMA_HOST=http://127.0.0.1:11434
# AUTOANNOTATION_REGEX_MODEL=
# CORS for browsers calling FastAPI directly (the Next proxy does not need it).
# Defaults: localhost:3000 origins plus a regex for private-network hosts.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGIN_REGEX=
# Passwordless reader accounts (6-digit OTP; see USAGE.md § Passwordless accounts):
EMAIL_BACKEND=console
# Terms version recorded on each new account at signup (users.terms_version).
# Bump it together with TERMS_VERSION in frontend/lib/legal.js when the legal
# pages change; existing accounts keep the version they accepted.
# TERMS_VERSION=draft-2026-09
# EMAIL_BACKEND=resend
# RESEND_API_KEY=
# EMAIL_FROM=Gene Autoannotator <onboarding@yourdomain.com>
# Admin alerts: every ALERT_CHECK_SECONDS the backend emails all active admins
# (via EMAIL_BACKEND; console prints to logs) when a rule trips. Each alert
# repeats at most every 6 hours. ALERT_CHECK_SECONDS=0 turns alerts off; a
# threshold of 0 turns off just that rule.
ALERT_CHECK_SECONDS=300
# Alert when this many jobs are queued.
ALERT_QUEUE_DEPTH=50
# Alert when jobs have been queued with no online job-taking worker (ready or
# provisioning; draining workers don't count) for this many minutes.
ALERT_NO_WORKER_MINUTES=15
# Alert when this fraction of jobs finished in the last hour failed (needs >= 5
# completed + failed; cancelled jobs are ignored).
ALERT_FAILURE_RATE=0.5
# Control-plane backups: every BACKUP_INTERVAL_SECONDS (default 21600 = 6 h,
# capped at 7 days; 0 disables) the backend uploads a snapshot of its SQLite DB
# and the profiles dir to MongoDB GridFS (bucket control_plane_backups in the
# MONGO_URI database) and keeps the newest BACKUP_KEEP. Needs MONGO_URI. The
# snapshot holds users, sessions, and sign-in codes: treat it like the DB.
BACKUP_INTERVAL_SECONDS=21600
BACKUP_KEEP=28
# Delete completed/failed/cancelled jobs (and batches left with no jobs) that
# finished more than this many days ago; checked daily. 0 keeps them forever.
JOB_RETENTION_DAYS=0
# Delete audit events older than this many days; checked daily. 0 keeps them
# forever. Expired sessions, used sign-in codes, and stale rate-limit rows are
# always pruned daily.
AUDIT_RETENTION_DAYS=365
# Set 1 when the frontend is served over HTTPS (production):
SESSION_COOKIE_SECURE=0
# Worker-pipeline settings (see worker.env.example). The backend imports the
# modules that read them: the mode and consensus model pick the regex helper's
# default model, the rest only matter on workers. An invalid
# AUTOANNOTATION_MODEL_MODE or a one-model AUTOANNOTATION_SUMMARY_MODELS stops
# the backend from starting.
# AUTOANNOTATION_MODEL_MODE=performance
# AUTOANNOTATION_SUMMARY_MODELS=
# AUTOANNOTATION_CONSENSUS_MODEL=
# AUTOANNOTATION_AGGREGATION_MODEL=
# AUTOANNOTATION_HTTP_GET_ATTEMPTS=3
# AUTOANNOTATION_HTTP_RETRY_BACKOFF_SEC=1.0
# AUTOANNOTATION_HTTP_COOLDOWN_SEC=0.5
# worker.env file NCBI_API_KEY falls back to when unset (default: worker.env at the repo root).
# WORKER_ENV_FILE=
