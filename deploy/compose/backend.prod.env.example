# Backend env for docker-compose.prod.yml. Copy to deploy/compose/backend.env
# (gitignored), replace every CHANGE_ME, then check it without printing values:
#   deploy/scripts/preflight-env.sh --role backend deploy/compose/backend.env
# Staging without a domain: see "Staging overrides" at the end.
# The bootstrap admin email is hardcoded in backend/access.py (no env var).

# --- Secrets (see deploy/docs for rotation) ---
# Generate with: deploy/scripts/generate-worker-token.sh
WORKER_API_TOKEN=CHANGE_ME
# Read-write Atlas user: annotation history and control-plane backups.
# MONGODB_URI is an accepted alias; set only one.
MONGO_URI=mongodb+srv://CHANGE_ME:CHANGE_ME@CHANGE_ME.mongodb.net/?retryWrites=true&w=majority
# MONGODB_URI=
# NCBI gene-name lookups during validation; ENTREZ_API_KEY is an accepted alias.
# NCBI_API_KEY=
# ENTREZ_API_KEY=

# --- Email (sign-in codes and admin alerts) ---
EMAIL_BACKEND=resend
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=Gene Autoannotator <noreply@CHANGE_ME>

# --- Behind Caddy ---
REQUIRE_WORKER_API_TOKEN=1
SESSION_COOKIE_SECURE=1
# Caddy overwrites X-Forwarded-For, and backend/frontend publish no ports, so
# the left-most entry is the real client IP. Required for per-IP limits.
TRUST_FORWARDED_FOR=1
# Advertised in startup logs as the worker BACKEND_URL; use the site URL.
BACKEND_PUBLIC_URL=https://CHANGE_ME
# Shown on /admin and /backend-info and stored in backup metadata (default "dev").
# APP_VERSION=

# --- Workers ---
# HPC-primary: accept submissions while no worker is warm (the dispatcher only
# launches Slurm workers after jobs are queued).
WORKER_CAPACITY_REQUIRED=0
LEASE_SECONDS=21600
MAX_ATTEMPTS=3
WORKER_OFFLINE_SECONDS=60
# REQUIRED_WORKER_VERSION=

# --- Submissions and quotas (admins bypass all but MAX_BATCH_SIZE; 0 = unlimited) ---
# Set 1 to reject new non-admin submissions with HTTP 503; queued/running jobs continue.
# SUBMISSIONS_PAUSED=1
MAX_QUEUED_JOBS=200
USER_MAX_ACTIVE_JOBS=20
USER_MAX_JOBS_PER_DAY=50
USER_MAX_BATCH_SIZE=25
# MAX_BATCH_SIZE=2000

# --- Rate limits (HTTP 429; 0 = unlimited) ---
IP_SIGNUPS_PER_DAY=5
IP_LOGINS_PER_HOUR=30
IP_SUBMITS_PER_HOUR=30
OTP_SENDS_PER_EMAIL_PER_HOUR=5

# --- Admin alerts (0 turns a rule off; ALERT_CHECK_SECONDS=0 turns all off) ---
ALERT_CHECK_SECONDS=300
ALERT_QUEUE_DEPTH=150
ALERT_NO_WORKER_MINUTES=30
ALERT_FAILURE_RATE=0.5

# --- Control-plane backups to MongoDB GridFS and job retention ---
BACKUP_INTERVAL_SECONDS=3600
BACKUP_KEEP=48
# Days after which finished jobs are purged; 0 keeps them forever.
JOB_RETENTION_DAYS=0

# --- Legal ---
# Bump together with TERMS_VERSION in frontend/lib/legal.js.
# TERMS_VERSION=draft-2026-09

# --- Rarely needed ---
# docker-compose.prod.yml sets PROFILES_DIR=/app/data/profiles (the volume); a value here is ignored.
# PROFILES_DIR=
# Catalog copied into an empty profiles volume on first start. The image ships no
# catalog, so this only matters if you mount one (migrated profiles need nothing).
# PROFILES_SEED_DIR=
# The regex helper (admin-only) needs an Ollama server reachable from the container.
# OLLAMA_HOST=http://CHANGE_ME:11434
# AUTOANNOTATION_REGEX_MODEL=
# Browsers only call the same-origin frontend, so CORS is not needed.
# CORS_ORIGINS=
# CORS_ORIGIN_REGEX=
# Worker-pipeline settings the backend reads at import (see backend.env.example);
# leave unset. An invalid value of the first two stops the backend from starting.
# AUTOANNOTATION_MODEL_MODE=
# AUTOANNOTATION_SUMMARY_MODELS=
# AUTOANNOTATION_CONSENSUS_MODEL=
# AUTOANNOTATION_AGGREGATION_MODEL=
# AUTOANNOTATION_HTTP_GET_ATTEMPTS=
# AUTOANNOTATION_HTTP_RETRY_BACKOFF_SEC=
# AUTOANNOTATION_HTTP_COOLDOWN_SEC=
# WORKER_ENV_FILE=

# --- Staging overrides (Pi without a domain, SITE_ADDRESS=:80) ---
# Change these lines in backend.staging.env:
#   SESSION_COOKIE_SECURE=0        (plain HTTP; otherwise the browser drops the session cookie)
#   EMAIL_BACKEND=console          (OTP codes: docker compose ... logs backend | grep email:console)
#   BACKUP_INTERVAL_SECONDS=0      (staging must not write snapshots into the production bucket)
#   MONGO_URI=<separate staging cluster>  (the DB name is fixed, so the prod cluster means the prod library)
#   BACKEND_PUBLIC_URL=http://<pi-lan-ip>:8080
# RESEND_API_KEY and EMAIL_FROM are not needed with EMAIL_BACKEND=console.
