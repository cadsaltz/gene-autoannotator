# Interpolation values for docker-compose.prod.yml (passed with --env-file).
# Copy to deploy/compose/compose.env (gitignored).

# Image tag pulled from ghcr.io/cadsaltz/gene-autoannotator-{backend,frontend}.
IMAGE_TAG=prod
# Public hostname; Caddy obtains its certificate automatically (DNS must point here
# and ports 80/443 must be reachable).
SITE_ADDRESS=CHANGE_ME.example.org
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
BACKEND_ENV_FILE=backend.env
FRONTEND_ENV_FILE=frontend.env
# Host port for docker-compose.worker-port.yml (cutover only).
CADDY_WORKER_PORT=8000
