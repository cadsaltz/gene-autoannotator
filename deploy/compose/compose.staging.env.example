# Staging on the Pi next to the running docker-compose.backend.yml stack
# (which keeps ports 3000 and 8000). Copy to deploy/compose/compose.staging.env
# and always run with -p gaa-staging so staging gets its own containers and volumes:
#   docker compose -p gaa-staging -f deploy/compose/docker-compose.prod.yml \
#     --env-file deploy/compose/compose.staging.env up -d
# Then open http://<pi-lan-ip>:8080.

# Locally built arm64 images until CI publishes them (see deploy/README.md).
IMAGE_TAG=staging
# No hostname: plain HTTP, no certificate, no HSTS.
SITE_ADDRESS=:80
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
BACKEND_ENV_FILE=backend.staging.env
FRONTEND_ENV_FILE=frontend.staging.env
