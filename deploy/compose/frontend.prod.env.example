# Frontend env for docker-compose.prod.yml. Copy to deploy/compose/frontend.env
# (gitignored), replace CHANGE_ME, then check it without printing values:
#   deploy/scripts/preflight-env.sh --role frontend deploy/compose/frontend.env

# Read-only Atlas user: the annotation pages query MongoDB directly.
MONGO_URI=mongodb+srv://CHANGE_ME:CHANGE_ME@CHANGE_ME.mongodb.net/?retryWrites=true&w=majority
# Server-side calls and the /api/backend proxy reach FastAPI on the compose network.
BACKEND_API_BASE_URL=http://backend:8000
