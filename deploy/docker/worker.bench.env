# Use with: run-worker-bench.sh --env-file worker.bench.env ...
# Default package is T. brucei gemma4-solo on one A100 (2 slots).
# See also worker.bench.tbrucei-gemma4.env (same knobs, more comments).

AUTOANNOTATION_MODEL_MODE=performance
AUTOANNOTATION_SUMMARY_MODELS=gemma4:12b
AUTOANNOTATION_AGGREGATION_MODEL=gemma3:27b
AUTOANNOTATION_SECTION_CHUNKING=true
AUTOANNOTATION_SECTION_EXCERPT_MAX_CHARS=15000
AUTOANNOTATION_SECTION_RETRIEVAL_THRESHOLD_CHARS=20000

# === Edit to match allocated GPUs ===
OLLAMA_FLEET_SERVERS=1
OLLAMA_FLEET_PARALLEL=2
OLLAMA_FLEET_SLOT_CTX=8192
OLLAMA_FLEET_KEEP_ALIVE=5m
OLLAMA_MAX_LOADED_MODELS=1
WORKER_MAX_SLOTS=2
WORKER_BENCH_SLOTS=2

WORKER_MODEL_MEMORY_BUDGET_GB=80

# Leave chat timeout unset for long performance jobs.
# OLLAMA_CHAT_TIMEOUT_SEC=36000
