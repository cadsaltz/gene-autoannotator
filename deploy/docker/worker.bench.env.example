# Optional overrides for: docker run --env-file ...
# Image already sets sensible performance / single-GPU defaults.

AUTOANNOTATION_MODEL_MODE=performance
OLLAMA_FLEET_SERVERS=1
OLLAMA_FLEET_PARALLEL=1
WORKER_MAX_SLOTS=2
# Bench/serve apply tier policy unless --keep-alive is set:
# warm_stack → 5m; overflow/swap → 0 (MAX_LOADED=1; switches evict).
# OLLAMA_FLEET_KEEP_ALIVE=5m
# Set 0 to skip dashboard ollama ps probes:
# WORKER_DASHBOARD_OLLAMA_PS=1
# Min seconds between /api/ps size refreshes (default 5); in-flight updates every frame:
# WORKER_DASHBOARD_OLLAMA_PS_INTERVAL_SEC=5
# Legacy ANNOTATION_MEMORY_BUDGET_GB is still accepted by the config reader.
WORKER_MODEL_MEMORY_BUDGET_GB=64

# Uncomment to fail fast on hung chat (not recommended for performance overnight runs):
# OLLAMA_CHAT_TIMEOUT_SEC=3600
