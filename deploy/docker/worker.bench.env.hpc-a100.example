# HPC A100 performance batch (~100 genes)
# Use with: run-worker-bench.sh --env-file worker.bench.env ...
#
# PARALLEL is per Ollama server (typically one server per GPU).
# RTX 2070 (~8 GB) was stable at parallel=2; A100s can go higher, but
# aggressive parallel often wedges Ollama — start here, only raise if stable.
#
# Set OLLAMA_FLEET_SERVERS to the number of GPUs on the allocated node.
# Example below assumes 4× A100 (common for ~320 GB total VRAM / node).

AUTOANNOTATION_MODEL_MODE=performance

# === Edit to match allocated GPUs ===
OLLAMA_FLEET_SERVERS=4

# Conservative-high per GPU (2× safe 2070 setting). If Ollama OOMs/wedges, try 3 then 2.
OLLAMA_FLEET_PARALLEL=4

# Match lanes: servers × parallel. Mild oversubscription is OK for a 100-gene batch.
WORKER_MAX_SLOTS=16

# Node has ample RAM; this is mainly legacy headroom / process admission.
ANNOTATION_MEMORY_BUDGET_GB=128

# Leave chat timeout unset for long performance jobs (unlimited).
# OLLAMA_CHAT_TIMEOUT_SEC=3600
