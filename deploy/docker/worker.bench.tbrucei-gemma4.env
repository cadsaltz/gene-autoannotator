# T. brucei TREU927 gemma4-solo worker-bench (one A100, two concurrent slots).
# Use with:
#   deploy/scripts/run-worker-bench.sh \
#     --image gene-autoannotator-worker:gemma4-solo \
#     --jobs deploy/batches/tbrucei-treu927-ge10-papers.jsonl \
#     --env-file deploy/docker/worker.bench.tbrucei-gemma4.env \
#     --output-dir "$SCRATCH/gen_json" \
#     --report "$SCRATCH/report.json" \
#     --models-dir "$SCRATCH/ollama-models" \
#     --slots 2

AUTOANNOTATION_MODEL_MODE=performance
AUTOANNOTATION_SUMMARY_MODELS=gemma4:12b
AUTOANNOTATION_AGGREGATION_MODEL=gemma3:27b

# Same excerpt tiers as the gemma4-alone model_spread_15k arm.
AUTOANNOTATION_SECTION_CHUNKING=true
AUTOANNOTATION_SECTION_EXCERPT_MAX_CHARS=15000
AUTOANNOTATION_SECTION_RETRIEVAL_THRESHOLD_CHARS=20000

# One Ollama server on the allocated GPU; two parallel lanes / worker slots.
OLLAMA_FLEET_SERVERS=1
OLLAMA_FLEET_PARALLEL=2
OLLAMA_FLEET_SLOT_CTX=8192
OLLAMA_FLEET_KEEP_ALIVE=5m
OLLAMA_MAX_LOADED_MODELS=1
WORKER_MAX_SLOTS=2
WORKER_BENCH_SLOTS=2

# A100-class VRAM. Drop to 40 and --slots 1 on a 40 GB card.
WORKER_MODEL_MEMORY_BUDGET_GB=80

# Image bakes go-basic.obo; override only if you bind-mount a newer file.
# GO_BASIC_OBO_PATH=/app/data/go-basic.obo

# Optional NCBI key (preferred). ENTREZ_API_KEY is accepted as fallback.
# NCBI_API_KEY=
# ENTREZ_API_KEY=

# AUTOANNOTATION_HTTP_COOLDOWN_SEC=0.5
# AUTOANNOTATION_HTTP_GET_ATTEMPTS=3
# AUTOANNOTATION_HTTP_RETRY_BACKOFF_SEC=1.0
# OLLAMA_CHAT_TIMEOUT_SEC=36000
