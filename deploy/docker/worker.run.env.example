# Use with: run-worker-run.sh --env-file worker.run.env ...
# Copied onto the shared SCRI path; referenced by WORKER_RUN_ENV_FILE in dispatcher.env.

# Required: public backend + same token as cloud WORKER_API_TOKEN.
BACKEND_URL=https://api.example.org
WORKER_API_TOKEN=replace-with-the-cloud-worker-token

# PARALLEL is per Ollama server (typically one server per GPU).
# Set OLLAMA_FLEET_SERVERS to the number of GPUs on the allocated node.
AUTOANNOTATION_MODEL_MODE=performance

# === Edit to match allocated GPUs ===
OLLAMA_FLEET_SERVERS=1

# If Ollama OOMs/wedges, try 3 then 2.
OLLAMA_FLEET_PARALLEL=1

# One claim per Slurm allocation.
WORKER_MAX_SLOTS=1

# Headroom / process admission.
WORKER_MODEL_MEMORY_BUDGET_GB=80

# Leave chat timeout unset for long performance jobs.
# OLLAMA_CHAT_TIMEOUT_SEC=36000
