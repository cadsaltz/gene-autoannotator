# Copy to dispatcher.env (gitignored) on the SCRI shared repo path.
# Used by deploy/scripts/dispatcher-once.sh (or set DISPATCHER_ENV_FILE).
#
# Single-worker-run rule: at most ONE Slurm job named gene-autoannotator-run is
# ever launched for this user. If one is already inflight, the dispatcher launches
# 0 on this pass. Concurrency is annotation subprocesses inside that allocation
# (see worker.run.env / OLLAMA_FLEET_*), not multiple Slurm workers.

# Required: public backend + same token as cloud WORKER_API_TOKEN.
BACKEND_URL=https://api.example.org
WORKER_API_TOKEN=replace-with-the-cloud-worker-token

# Absolute path to the sbatch script (dispatcher passes GAA_REPO_ROOT via --export=ALL).
DISPATCHER_SBATCH_SCRIPT=/shared/gene-autoannotator/deploy/slurm/worker-run.sbatch

# Max jobs one worker run drains per Slurm allocation (chunk size), NOT how many
# Slurm workers to launch. The dispatcher still launches at most one run job.
DISPATCHER_MAX_JOBS_PER_WORKER=500

# Backward compat only — dispatcher code still reads this today. Effective Slurm
# inflight cap is always 1 (single gene-autoannotator-run job); do not treat this
# as a multi-worker knob.
DISPATCHER_MAX_INFLIGHT=1

# Inherited by sbatch (--export=ALL) for the Apptainer child:
WORKER_IMAGE=/shared/gene-autoannotator/gene-autoannotator-worker_0.2.sif
WORKER_RUN_ENV_FILE=/shared/gene-autoannotator/worker.run.env

# Optional path overrides (defaults in deploy/slurm/worker-run.sbatch):
# WORKER_MODELS_DIR=/shared/gene-autoannotator/models
# WORKER_CACHE_DIR=/shared/gene-autoannotator/.cache/worker-run
# WORKER_OUTPUT_DIR=/shared/gene-autoannotator/gen_json
