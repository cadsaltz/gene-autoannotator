# Copy to worker.env (gitignored) or let `python -m worker` prompt on first run.
# Set keys here are respected on restart (env-as-source-of-truth).
BACKEND_URL=http://127.0.0.1:8000
# Legacy alias (used only when BACKEND_URL is unset):
# COORDINATOR_URL=http://127.0.0.1:8000
WORKER_API_TOKEN=dev-token
# Model weights / KV / Ollama memory cap (GB). -1 or omit = machine-derived max.
# Caps fleet sizing recommendations; does NOT set job slots (see WORKER_MAX_SLOTS).
WORKER_MODEL_MEMORY_BUDGET_GB=24
# Legacy alias — read once, migrated to WORKER_MODEL_MEMORY_BUDGET_GB on persist:
# ANNOTATION_MEMORY_BUDGET_GB=24
# Fleet shape (prompted on first run if missing):
# OLLAMA_FLEET_SERVERS=2
# OLLAMA_FLEET_PARALLEL=2
# WORKER_MAX_SLOTS=4
# Operator knobs (write-if-missing on first ensure; never overridden by VRAM tier):
# OLLAMA_FLEET_SLOT_CTX=8192
# OLLAMA_FLEET_KEEP_ALIVE=0
# OLLAMA_MAX_LOADED_MODELS=1
# AUTOANNOTATION_SECTION_CHUNKING=true
# Managed ollama serve gets OLLAMA_CONTEXT_LENGTH = SLOT_CTX × OLLAMA_FLEET_PARALLEL
# (not an operator file key). For July-like full sections + small context A/B:
#   OLLAMA_FLEET_SERVERS=1
#   OLLAMA_FLEET_PARALLEL=1
#   WORKER_MAX_SLOTS=1
#   OLLAMA_FLEET_SLOT_CTX=2048
#   AUTOANNOTATION_SECTION_CHUNKING=false
# Dashboard IN MEM via ollama /api/ps (set 0 if probes stress Ollama):
# WORKER_DASHBOARD_OLLAMA_PS=1
# How often to refresh /api/ps (seconds). Dashboard UI still updates ~2Hz; sizes reuse cache.
# WORKER_DASHBOARD_OLLAMA_PS_INTERVAL_SEC=5
# Require this Ollama *server* version (default 0.33.1). Set off to skip the check:
# OLLAMA_REQUIRE_VERSION=0.33.1
# AUTOANNOTATION_MODEL_MODE=performance
# JOB_MEMORY_ESTIMATE_GB=20
# WORKER_MEMORY_HEADROOM_GB=4
# WORKER_CACHE_DIR=./.cache
# WORKER_OUTPUT_DIR=gen_json
# NCBI_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_CHAT_TIMEOUT_SEC=   # unset = unlimited (required for performance models)
# OLLAMA_ROUTER_READ_TIMEOUT_SEC=   # unset = unlimited
